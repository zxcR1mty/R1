<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Мои Dota-профили</title>
    <!-- Подключаем иконки Font Awesome (бесплатно) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a0a0a; /* почти чёрный */
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .card {
            background: #141414;
            border-radius: 40px;
            padding: 45px 35px;
            max-width: 520px;
            width: 100%;
            box-shadow: 0 0 40px rgba(100, 100, 255, 0.15), 0 20px 60px rgba(0,0,0,0.9);
            text-align: center;
            border: 1px solid #2a2a2a;
            backdrop-filter: blur(2px);
        }
        h1 {
            color: #f0f0f0;
            font-size: 30px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 6px;
        }
        h1 i {
            color: #ffcc00;
            margin-right: 10px;
        }
        .subtitle {
            color: #888;
            font-size: 15px;
            margin-bottom: 30px;
            border-bottom: 1px solid #2a2a2a;
            padding-bottom: 22px;
            letter-spacing: 0.3px;
        }
        .link-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            width: 100%;
            padding: 20px 0;
            margin-bottom: 18px;
            border-radius: 18px;
            text-decoration: none;
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            transition: all 0.25s ease;
            box-shadow: 0 6px 20px rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.05);
            letter-spacing: 0.5px;
            position: relative;
            overflow: hidden;
        }
        .link-btn:last-child {
            margin-bottom: 0;
        }
        /* Эффект свечения при наведении */
        .link-btn:hover {
            transform: translateY(-3px) scale(1.02);
            filter: brightness(1.15);
            box-shadow: 0 12px 30px rgba(0,0,0,0.7);
        }
        /* Иконки внутри кнопок — делаем крупными */
        .link-btn i {
            font-size: 32px;
            width: 40px;
            text-align: center;
            color: inherit;
            text-shadow: 0 0 12px currentColor;
        }
        /* Цвета кнопок */
        .link-btn.stratz {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            border-color: #3b82f6;
        }
        .link-btn.dotabuff {
            background: linear-gradient(135deg, #14532d, #22c55e);
            border-color: #22c55e;
        }
        .link-btn.opendota {
            background: linear-gradient(135deg, #7c2d12, #f97316);
            border-color: #f97316;
        }
        /* Текст внутри кнопки */
        .link-btn span {
            flex: 1;
            text-align: left;
        }
        .footer {
            margin-top: 32px;
            color: #555;
            font-size: 14px;
            border-top: 1px solid #2a2a2a;
            padding-top: 22px;
            letter-spacing: 0.3px;
        }
        .footer i {
            color: #ff4444;
            margin: 0 4px;
        }
        .footer a {
            color: #888;
            text-decoration: none;
            transition: 0.2s;
        }
        .footer a:hover {
            color: #fff;
        }
        /* Адаптив */
        @media (max-width: 480px) {
            .card { padding: 30px 20px; }
            .link-btn { font-size: 18px; padding: 16px 0; }
            .link-btn i { font-size: 26px; width: 32px; }
        }
    </style>
</head>
<body>
    <div class="card">
        <h1><i class="fas fa-dragon"></i> My Dota Hub</h1>
        <div class="subtitle">Нажми на кнопку — перейди к статистике</div>

        <!-- STRATZ -->
        <a href="https://stratz.com/players/1596319409" target="_blank" class="link-btn stratz">
            <i class="fas fa-chart-line"></i>
            <span>STRATZ</span>
            <i class="fas fa-chevron-right" style="font-size:18px; opacity:0.5;"></i>
        </a>

        <!-- DOTABUFF -->
        <a href="https://ru.dotabuff.com/players/1596319409" target="_blank" class="link-btn dotabuff">
            <i class="fas fa-shield-halved"></i>
            <span>DOTABUFF</span>
            <i class="fas fa-chevron-right" style="font-size:18px; opacity:0.5;"></i>
        </a>

        <!-- OPENDOTA -->
        <a href="https://www.opendota.com/players/1596319409" target="_blank" class="link-btn opendota">
            <i class="fas fa-fire"></i>
            <span>OPENDOTA</span>
            <i class="fas fa-chevron-right" style="font-size:18px; opacity:0.5;"></i>
        </a>

        <div class="footer">
            <i class="fas fa-heart"></i> для моих подписчиков в TikTok
        </div>
    </div>
</body>
</html>
